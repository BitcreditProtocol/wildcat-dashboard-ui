NODE_ENV=production
VITE_MODE=production

APP_PORT=8181

VITE_API_BASE_URL=http://127.0.0.1:4242

VITE_KEYCLOAK_URL=http://localhost:8080/
VITE_KEYCLOAK_REALM=dev
VITE_KEYCLOAK_CLIENT_ID=bff-dashboard
VITE_API_MOCKING_ENABLED=false

# Sentry error reporting; off unless VITE_SENTRY_ENABLED is exactly "true" and a DSN is set
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=

# Crowdin Configuration
VITE_BITCR_DEV_INCLUDE_CROWDIN_IN_CONTEXT_TOOLING=false
CROWDIN_PERSONAL_TOKEN=your-crowdin-personal-access-token
